PORT=4200

# FusionAuth — [LOCAL] YUILINK APP (tenant [DEV] WEBLIFE-DIRECT)
FUSIONAUTH_URL=https://fa.nextgen-demo.bindcloud.jp
FUSIONAUTH_ISSUER=fa.nextgen-demo.bindcloud.jp
FUSIONAUTH_TENANT_ID=10f53b44-ee2e-451b-b0aa-9c0fba451191
FUSIONAUTH_APPLICATION_ID=474e1bec-097f-4762-be6a-0e831d396540
FUSIONAUTH_CLIENT_SECRET=
# Used only by POST /auth/resend-verification. Same key as apps/backend/.env.
FUSIONAUTH_API_KEY=
FUSIONAUTH_CALLBACK_URL=http://localhost:4200/auth/fusionauth/callback
FUSIONAUTH_POST_LOGIN_REDIRECT=http://localhost:4200/dashboard

# Base URL of this app, used for the invite link in the mail.
APP_URL=http://localhost:4200

# Invite mail — SendGrid SMTP, same values as apps/backend/.env.
# EMAIL_FROM must be a verified sender in SendGrid.
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=apikey
EMAIL_PASSWORD=
EMAIL_FROM=noreply@yuilink.co.jp

# Empty = host-only cookies (fine for localhost).
COOKIE_DOMAIN=

# Single Logout denylist. Empty = in-memory (lost on restart, not shared).
# Point at the control panel's Valkey to share logout state across apps.
VALKEY_HOST=
VALKEY_PORT=6379
VALKEY_USR=
VALKEY_PWD=
